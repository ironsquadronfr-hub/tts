-- What the loader shell relays to the brain.
--
-- Under the loader the logic runs in the brain object, which hears every
-- event the mod uses except two that only reach Global, and Global is the
-- shell: collisions of an object registered with registerCollisions()
-- (measured 14/11/2026) and digits typed over an object (measured
-- 16/11/2026). The shell relays the events listed in relayedEvents to
-- relayEvent() below, which calls the usual handler, so a module defines
-- onObjectCollisionEnter or onObjectNumberTyped as if it ran in Global.
-- Without the loader the logic runs in Global and TTS calls those directly.
--
-- Only list an event measured as not reaching the brain: one it hears
-- itself would arrive twice.

relayedEvents = ',onObjectCollisionEnter,onObjectCollisionStay,onObjectCollisionExit,onObjectNumberTyped,'

-- Returns what the handler returns: true on onObjectNumberTyped cancels
-- TTS's own handling of the digit.
function relayEvent(params)
  local handler = _G[params.name]
  if handler ~= nil then
    return handler(table.unpack(params.args, 1, params.args.n))
  end
end

-- Shells published before relayedEvents relay collisions this way.
relayCollisions = true

function relayCollision(params)
  local handler = _G["onObjectCollision" .. tostring(params.event)]
  if handler ~= nil then
    handler(params.object, params.info)
  end
end
