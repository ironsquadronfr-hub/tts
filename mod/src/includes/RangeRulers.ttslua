
-- ============ Iron Squadron : boutons orientes selon la face visible ==========
-- Un bouton TTS est attache au repere de l'objet : jeton retourne, on le voit
-- depuis l'autre face et son angle dans le plan apparait NIE — ce n'est plus le
-- bon cote du bouton qui longe le bord du jeton.
--
-- La reponse d'origine etait de creer DEUX boutons superposes, le second en
-- {0,0,180} pour le verso. Ca passe a peu pres sur un « R » (on lit un R un peu
-- etrange), mais pas des qu'on ajoute une autre lettre : deux « E » superposes se
-- lisent « H ». On garde donc UN bouton et on le reoriente au retournement.
--
-- ⚠⚠ UN SEUL ANGLE PAR BOUTON : son angle de PLACEMENT sur le cercle (phi),
-- mesure depuis l'avant du jeton. L'orientation de l'etiquette se deduit, et elle
-- vaut -phi : TTS tourne l'etiquette dans le sens INVERSE du placement. Avoir
-- expose deux angles a coute une erreur — en passant le meme signe aux deux, le
-- bouton se retrouvait decale de 2*phi par rapport au rayon, et c'etait sa
-- largeur, et non sa longueur, qui longeait le bord du jeton.
--
-- Formule : a l'endroit { 0, -phi, 0 }, au verso { 0, phi, 180 }.
-- Controle : phi = 0 redonne {0,0,180}, soit exactement l'ancien second bouton.
--
-- ⚠ Le fait qu'un bouton apparaisse de l'AUTRE COTE au verso n'est pas un
-- defaut : c'est le meme objet vu depuis l'autre face.
--
-- ⚠ Ces fonctions vivent ICI, dans RangeRulers, parce que POI ne passe PAS par
-- TokenWithRangeRuler — il a sa propre copie du bouton. En revanche onRotate
-- n'est PAS defini ici : ce fichier est aussi inclus par le Global, l'Order Token
-- et les BombCarts, qui n'ont pas de bouton a reorienter. Chaque porteur de
-- boutons declare son propre onRotate appelant isqMajBoutons.
ISQ_BOUTON_RAYON = 0.7

isqBoutonsOrientes = {}

function isqOrientationBouton(phi, flip)
  if flip == nil then flip = self.getRotation().z end
  if flip > 90 and flip < 270 then return { 0, phi, 180 } end
  return { 0, -phi, 0 }
end

function isqPositionBouton(phi)
  local r = math.rad(phi)
  return { ISQ_BOUTON_RAYON * math.sin(r), 0.1, ISQ_BOUTON_RAYON * math.cos(r) }
end

-- A appeler apres avoir cree un bouton pour qu'il suive la face visible.
function isqEnregistrerBouton(libelle, phi)
  table.insert(isqBoutonsOrientes, { libelle = libelle, phi = phi })
end

function isqMajBoutons(flip)
  for _, e in ipairs(isqBoutonsOrientes) do
    for _, b in ipairs(self.getButtons() or {}) do
      if b.label == e.libelle then
        self.editButton({ index = b.index, rotation = isqOrientationBouton(e.phi, flip) })
        break
      end
    end
  end
end
-- =============================================================================

require('!/data/RangeRulerLinks')
require('!/IsqBridge')

function showRangeOnHoveredModel(hoverObject)
  -- When a player has turned the Iron Squadron overlays on for the table, draw
  -- the range with the Projector renderer instead. When they are off, which is
  -- the default, everything below runs unchanged.
  if isqOverlaysOn() then
    if hoverObject and hoverObject.interactable then
      isqToggleRange({figGUID = hoverObject.getGUID(), forceFigMode = true})
    end
    return
  end
  clearRangeRulers()
  if hoverObject then
    if hoverObject.interactable then
      if selectedUnitObj == hoverObject then
        selectedUnitObj = nil
        return
      else
        spawnRangeRuler(hoverObject)
        selectedUnitObj = hoverObject
      end
    end
  else
    selectedUnitObj = nil
  end
end

-- Refactor this to work with the refactored spawnRangeRuler()
function clearRangeRulers()
  if rangeRuler ~= nil then
    destroyObject(rangeRuler)
    rangeRuler = nil
  end

  noRulers = true
end


function spawnRangeRuler(rangeSourceObject, projectorBundleOverride)
  if rangeSourceObject == nil then 
    return 
  end

  local rulerBundleToSpawn = ""

  if projectorBundleOverride ~= nil then
    rulerBundleToSpawn = projectorBundleOverride
  else
    -- Get unit data from leader if leader hovered
    local unitData = rangeSourceObject.getTable("unitData")

    -- If leader not hovered, get leader GUID from mini data to get unit data
    if not unitData then
      local unitLeader = getObjectFromGUID(rangeSourceObject.getVar("leaderGUID"))
      if not unitLeader then
        return 
      end
      unitData = unitLeader.getTable("unitData")
      if not unitData then
        return 
      end
    end

    local baseSize = unitData.baseSize
    local rulerBundleTable = getRangeRulerLinks()
    rulerBundleToSpawn = rulerBundleTable[baseSize] 
  end

  basePos = rangeSourceObject.getPosition()
  baseRot = rangeSourceObject.getRotation()

  rangeRuler = spawnObject({
    type = "Custom_AssetBundle",
    position = {basePos.x, basePos.y + 20, basePos.z},
    rotation = {90, baseRot.y, 0},
    scale = {0,0,0} -- 0 scale will hide TTS default box and won't impact projector
  })

  rangeRuler.setCustomObject({
    type = 0,
    assetbundle = rulerBundleToSpawn
  })

  rangeRuler.setLock(true)
  rangeRuler.setName("Range Ruler")
  luaScript = "targetGUID = '"..rangeSourceObject.getGUID().."'\n function onFixedUpdate()\nif targetGUID ~= nil then\n targetObj = getObjectFromGUID(targetGUID)\n local targetPosition = targetObj.getPosition()\n self.setPosition({targetPosition.x, targetPosition.y + 20, targetPosition.z})\n self.setRotation({0,targetObj.getRotation().y,0})\n end\n end"
  rangeRuler.setLuaScript(luaScript)

  noRulers = false
end
