-- Flying vehicle stand (Legion 2026): object data and script.
-- GENERATED by socle-vehicule-volant/outils/exporter_vers_mod.py (swl-assets) —
-- edit the stand there, not here.
--
-- A unit whose mini is {"flyingStand": true} gets this object (hub carrying
-- the stem and the 4 prongs as attachments, see Shelf:_spawnModel), and its
-- script gets FLYING_STAND_SCRIPT appended after the mini script (SpawnList).

FLYING_STAND_TAG = "FlyingStand"

-- The ship on top: its unit's mini gives {"flyingStand": true, "ship": {parts =
-- [{mesh, diffuse}], scale, peg = {x, y, z}}}, peg being the point under the
-- fuselage (model units) that sits on the top of the stem. The parts carry
-- the invisible mesh as collider: no weight (only the hub's mass counts).
FLYING_STAND_STEM_TOP = 12.0            -- inches above the table
FLYING_STAND_INVISIBLE = "https://raw.githubusercontent.com/ironsquadronfr-hub/swl-assets/main/assets/flying_stand_invisible_v1.obj"

