FLYING_STAND_SCRIPT = [==[
-- Flying vehicle stand (Star Wars: Legion, 2026).
--
-- One physical object: this hub carries the stem and the 4 prongs as
-- ATTACHMENTS, each keeping the collider of its own shape, so TTS physics does
-- the rest (stands on its feet, tilts on terrain, collides normally). The hub
-- is a Figurine: TTS puts it upright when it is picked up.
--
-- This script adds five things:
--   A/E (Q/E on QWERTY), stand on the table: aiming at the prongs (beyond the
--     hub edge) turns the prongs; aiming at the hub or stem turns the stand,
--     the prongs keeping their heading. While HELD, A/E turns the prongs by
--     5 degrees (see turnHeldProngs).
--   Grab by the prongs: the stand stays put, the prongs turn freely after
--     the pointer (see grabProngs).
--   Repair stand (right-click): the prongs squared again (90 degrees apart,
--     each visual twin on its physical twin).
--   Self-righting: a stand lying still, tilted more than TOPPLED degrees, is
--     put back upright with its heading. Below that it stays tilted on terrain.
--   In the mod: the unit leader's LCK button red when the stand is locked
--     (see syncLockButton).
-- The prongs never end inside a piece of terrain (see liftOverTerrain).

local HUB_RADIUS = 1.05      -- inches: hub edge (25.4 mm) + 5 %
local STEP = 15              -- degrees per A/E
local TOPPLED = 60           -- degrees
local CHECK_EVERY = 1        -- seconds, self-righting check
local PRONG_TAG = "FlyingStandProng"

local COS_TOPPLED = math.cos(math.rad(TOPPLED))
local ROTATE_LEFT = Player.Action.RotateIncrementalLeft
local ROTATE_RIGHT = Player.Action.RotateIncrementalRight
local atan2 = math.atan2 or math.atan
local busy = false
local BRAIN_GUID = "b7a1e0"  -- the mod's brain (its logic outside Global)

-- Rotation matrices, Unity convention: R = Ry * Rx * Rz (Euler angles, degrees)
local function matrix(e)
  local x, y, z = math.rad(e[1] or e.x), math.rad(e[2] or e.y), math.rad(e[3] or e.z)
  local cx, sx, cy, sy, cz, sz = math.cos(x), math.sin(x), math.cos(y), math.sin(y), math.cos(z), math.sin(z)
  return {
    { cy * cz + sy * sx * sz, -cy * sz + sy * sx * cz, sy * cx },
    { cx * sz,                cx * cz,                 -sx     },
    { -sy * cz + cy * sx * sz, sy * sz + cy * sx * cz, cy * cx },
  }
end
local function mul(A, B)
  local C = {}
  for i = 1, 3 do
    C[i] = {}
    for j = 1, 3 do C[i][j] = A[i][1] * B[1][j] + A[i][2] * B[2][j] + A[i][3] * B[3][j] end
  end
  return C
end
local function transpose(A)
  return { { A[1][1], A[2][1], A[3][1] }, { A[1][2], A[2][2], A[3][2] }, { A[1][3], A[2][3], A[3][3] } }
end
local function euler(R)
  local x = math.deg(math.asin(math.max(-1, math.min(1, -R[2][3]))))
  return { x % 360, math.deg(atan2(R[1][3], R[3][3])) % 360, math.deg(atan2(R[2][1], R[2][2])) % 360 }
end
local function yaw(a) return matrix({ 0, a, 0 }) end
-- heading (degrees around the local up axis) of rotation R seen from frame F
local function headingIn(F, R)
  local L = mul(transpose(F), R)
  return math.deg(atan2(L[1][3], L[3][3]))
end

-- Asks the mod's brain (its flying move, !/FlightMove) fn about this stand.
-- Harmless anywhere else: nil when it fails or there is no such function.
local function askBrain(fn, params)
  params = params or {}
  params.guid = self.getGUID()
  local brain = getObjectFromGUID(BRAIN_GUID) or Global
  local ok, answer = pcall(function() return brain.call(fn, params) end)
  return ok and answer or nil
end

-- A flying move in progress (ruler, arc lines) follows an A/E turn.
local function tellBrainTurned()
  askBrain("flightStandTurned")
end

local function isProng(attachment)
  for _, t in ipairs(attachment.tags or {}) do
    if t == PRONG_TAG then return true end
  end
  return false
end

-- Each prong has two twins: the physical one carries its collider
-- ("... (collision)"), the visual one its plexiglass. Not one visual cross
-- for the 4: detached, a piece gets from TTS a box collider its size, 9.8"
-- square for a cross, knocking everything about (measured, 26/11).
local function isPhysical(name)
  return (name or ""):find("%(collision%)") ~= nil
end

-- Detaches the visual prongs, locked: {obj, h = heading in frame R}, and the
-- set of them (they have a collider once detached, measured: measures of
-- what lies under the stand must skip them). Only the visual twins: taking
-- the physical twins' colliders off a HELD stand made it hop (measured).
local function detachVisual(R)
  local items, skip = {}, {}
  local list = self.getAttachments()
  for i = #list, 1, -1 do                  -- from the end: indexes stay valid
    local a = list[i]
    if isProng(a) and not isPhysical(a.name) then
      local o = self.removeAttachment(a.index)
      if o then
        o.setLock(true)
        items[#items + 1] = { obj = o, h = headingIn(R, matrix(o.getRotation())) }
        skip[o] = true
      end
    end
  end
  return items, skip
end

-- The prongs must never end inside a piece of terrain (Martin): the top of
-- what lies under them, two boxes foot to foot along the prongs (heading
-- yaw, flat), the stand, its detached prongs (skip) and the flying move's
-- tools aside. A Physics.cast box meets each object at its highest point
-- under the footprint (measured). nil if nothing.
local TOOLS = { ["Flight Ruler"] = true, ["Flight Line"] = true, ["Maximum Move"] = true }
local PRONG_SPAN, PRONG_WIDTH = 8.3, 0.55
local function groundUnderProngs(pos, yawDeg, skip)
  local best
  for _, d in ipairs({ 0, 90 }) do
    for _, hit in ipairs(Physics.cast({
      origin = { pos.x, pos.y + 10, pos.z }, direction = { 0, -1, 0 }, type = 3,
      size = { PRONG_WIDTH, 0.02, PRONG_SPAN }, orientation = { 0, yawDeg + d, 0 }, max_distance = 60,
    }) or {}) do
      local o = hit.hit_object
      if o ~= nil and hit.distance > 0 and o ~= self and not skip[o] and not TOOLS[o.getName()] then
        if best == nil or hit.point.y > best then best = hit.point.y end
      end
    end
  end
  return best
end

-- The flat heading of the hub's forward axis.
local function flatYaw()
  local f = self.getTransformForward()
  return math.deg(atan2(f.x, f.z))
end

-- The hub raised, if need be, so that prongs at heading h (in its frame)
-- lie on top of the terrain: physics then tilts it onto the rest.
local function liftOverTerrain(p, h, skip)
  local g = groundUnderProngs(p, flatYaw() + h, skip)
  if g ~= nil and g > p.y + 0.01 then
    return Vector(p.x, g + 0.005, p.z)
  end
  return p
end

-- In the mod this script is appended to the unit leader's: its LCK button
-- turns red when the stand is locked, whoever locked it (Martin).
-- updateLockBtnColor is the leader's; absent elsewhere.
local shownLocked = nil
local function syncLockButton()
  local locked = self.getLock()
  if locked ~= shownLocked and updateLockBtnColor then
    shownLocked = locked
    pcall(updateLockBtnColor)
  end
end

-- Turns the hub by dHub and the prongs by dProngs (degrees, around the stem):
-- lock the hub (without its feet it would fall), detach the prongs and park
-- them far below (no overlap with the hub), turn the hub, then put the prongs
-- back, squared, over any terrain, and re-attach them in the same frame,
-- from where the hub is now. pre: prongs already detached by a grab or an
-- A/E in hand, {obj, h = heading in the hub's frame}, left where they are.
-- The stand ends UNLOCKED, unless keepLock and it was locked: the lock
-- found here may be someone else's, only for a frame (the flying move locks
-- the stand it drops); kept, it left the stand locked for good, impossible
-- to pick up (seen by Martin).
local function turn(dHub, dProngs, pre, keepLock)
  if busy then return end
  -- the flying move may be putting this stand down (its prongs off and on
  -- again, the stand locked for a frame): wait for it to finish
  if askBrain("flightStandDropping") then
    Wait.frames(function() turn(dHub, dProngs, pre, keepLock) end, 2)
    return
  end
  busy = true
  local wasLocked = (keepLock and self.getLock()) or false
  self.setLock(true)
  local Rh = matrix(self.getRotation())
  local park = self.getPosition() + Vector(0, -50, 0)
  local prongs, headings = {}, {}
  for _, it in ipairs(pre or {}) do
    prongs[#prongs + 1] = it.obj
    headings[#prongs] = it.h
  end
  local list = self.getAttachments()
  for i = #list, 1, -1 do                  -- from the end: indexes stay valid
    if isProng(list[i]) then
      local o = self.removeAttachment(list[i].index)
      if o then
        prongs[#prongs + 1] = o
        headings[#prongs] = headingIn(Rh, matrix(o.getRotation()))
        o.setLock(true)
        o.setPosition(park)
      end
    end
  end
  -- square them again: the 4 prongs stand 90 degrees apart and each visual
  -- twin on its physical twin (a move over terrain left them skewed, seen by
  -- Martin); the physical twins give the reference
  local base
  for k, o in ipairs(prongs) do
    if isPhysical(o.getName()) then base = headings[k] break end
  end
  base = base or headings[1]
  for k, h in ipairs(headings) do
    headings[k] = base + 90 * math.floor(((h - base) % 360) / 90 + 0.5)
  end
  if dHub ~= 0 then self.setRotation(euler(mul(Rh, yaw(dHub)))) end
  Wait.frames(function()
    local p = self.getPosition()
    local Rnow = matrix(self.getRotation())
    local turned = headingIn(Rh, Rnow)
    -- prongs about to land in terrain: the hub goes up onto it first
    local skip = {}
    for _, o in ipairs(prongs) do skip[o] = true end
    if headings[1] then
      p = liftOverTerrain(p, headings[1] + dProngs - turned, skip)
      self.setPosition(p)
    end
    for k, o in ipairs(prongs) do
      if not o.isDestroyed() then
        o.setPosition(p)
        o.setRotation(euler(mul(Rnow, yaw(headings[k] + dProngs - turned))))
        o.setLock(false)
        self.addAttachment(o)
      end
    end
    self.setLock(wasLocked)
    Wait.frames(function()
      if not wasLocked then self.setVelocity({ 0, -0.05, 0 }) end   -- wake the body up
      busy = false
      syncLockButton()
      tellBrainTurned()
    end, 2)
  end, 2)
end

local function rightIfToppled()
  if busy or not self.resting or self.held_by_color or self.getLock() then return end
  local up = self.getTransformUp()
  if up.y > COS_TOPPLED then return end
  local f = self.getTransformForward()
  if math.abs(f.y) > 0.95 then f = { x = -up.x, z = -up.z } end   -- lying on its face: use the top
  self.setRotation({ 0, math.deg(atan2(f.x, f.z)) % 360, 0 })
  self.setPosition(self.getPosition() + Vector(0, 0.3, 0))
end

-- Started when the script loads, not in onLoad: in the mod this script is
-- appended to the mini script, which has its own onload.
Wait.time(function()
  rightIfToppled()
  syncLockButton()
end, CHECK_EVERY, -1)

-- The mod's flying move turns the stand this way (its prongs keep their
-- heading, like A/E on the hub): obj.call("turnStand", {degrees = d}).
function turnStand(params)
  turn(params and params.degrees or 0, 0)
end

-- Grabbing the stand by its prongs (pointer beyond the hub edge, as for A/E)
-- turns the prongs, freely, after the pointer (Martin's call): the stand is
-- held in place, upright, its visual prongs come off (detachVisual) and
-- follow the pointer round the stem, riding over terrain; once
-- dropped, all prongs go on again, squared, by turn(). Grabbed by the hub or
-- the stem, the whole stand moves as before. The brain's flying move uses
-- the same rule and leaves a grab of the prongs alone.
local grab = nil

-- The stand where it is held, still. Also on release: TTS then sets the
-- object down where IT carried it, under the pointer, and the drop event
-- only comes a frame later (measured: one frame 6.6 inches off, then back).
local function pinGrab(g)
  self.setPosition(g.at or g.pos)
  self.setRotation(g.rot)
  self.setVelocity({ 0, 0, 0 })
  self.setAngularVelocity({ 0, 0, 0 })
end

local function grabStep()
  local g = grab
  -- turned over terrain, the prongs ride over it: the hub goes up
  local h = g.items[1] and g.items[1].h + g.delta
  g.at = h and liftOverTerrain(g.pos, h, g.skip) or g.pos
  pinGrab(g)
  local ptr = Player[g.color].getPointerPosition()
  if ptr then g.delta = math.deg(atan2(ptr.x - g.pos.x, ptr.z - g.pos.z)) - g.a0 end
  for _, it in ipairs(g.items) do
    if not it.obj.isDestroyed() then
      it.obj.setPosition(g.at)
      it.obj.setRotation(euler(mul(g.Rh, yaw(it.h + g.delta))))
    end
  end
end

-- Every frame while held, in a COROUTINE: a Wait.frames step runs before TTS
-- moves the held object, which then won (the stand followed the pointer,
-- measured); a coroutine step runs after it, as the brain's flying move
-- does. It sees the release in that very frame and puts the stand back at
-- once, locked.
function flyingStandGrabLoop()
  while grab ~= nil and self.held_by_color ~= nil do
    grabStep()
    coroutine.yield(0)
  end
  if grab ~= nil then          -- released: back in place in the same frame
    self.setLock(true)
    pinGrab(grab)
  end
  return 1
end

local function grabProngs(color)
  if busy or grab then return end
  local ptr, p = Player[color].getPointerPosition(), self.getPosition()
  if not ptr or (ptr.x - p.x) ^ 2 + (ptr.z - p.z) ^ 2 <= HUB_RADIUS ^ 2 then return end
  -- held upright, like a mini picked up (Martin): its prongs' headings are
  -- read in its own frame, tilted or not, and laid in the upright one
  local Rtilt = matrix(self.getRotation())
  local rot = { 0, flatYaw(), 0 }
  local g = { color = color, pos = p, rot = rot, Rh = matrix(rot), delta = 0,
    a0 = math.deg(atan2(ptr.x - p.x, ptr.z - p.z)) }
  g.items, g.skip = detachVisual(Rtilt)
  grab = g
  startLuaCoroutine(self, "flyingStandGrabLoop")
end

-- A/E while the stand is HELD (by the hub: the whole stand moves) turns the
-- prongs by HELD_STEP (Martin's call): the visual twins come off
-- (detachVisual) and ride with the stand, turned; the physical twins follow
-- once dropped. Grabbed by the prongs,
-- A/E adds the same step to the turn after the pointer. In the brain's
-- flying move the brain holds the prongs: it is asked first.
local HELD_STEP = 5
local hold = nil

-- Held, the stand rides HOLD_LIFT above what lies under its prongs, set
-- here every frame: TTS lifts a held object over what is under it, and the
-- detached visual prongs (they have a collider, measured) were under it: it
-- climbed them frame after frame (seen by Martin).
local HOLD_LIFT = 1
local function holdStep()
  local h = hold
  if h == nil or self.held_by_color == nil then return end
  local p = self.getPosition()
  local g = h.items[1] and groundUnderProngs(p, flatYaw() + h.items[1].h + h.offset, h.skip)
  if g ~= nil then
    p = Vector(p.x, g + HOLD_LIFT, p.z)
    self.setPosition(p)
    self.setVelocity({ 0, 0, 0 })
  end
  local R = matrix(self.getRotation())
  for _, it in ipairs(h.items) do
    if not it.obj.isDestroyed() then
      it.obj.setPosition(p)
      it.obj.setRotation(euler(mul(R, yaw(it.h + h.offset))))
    end
  end
  Wait.frames(holdStep, 1)
end

local function turnHeldProngs(d)
  if grab then
    grab.a0 = grab.a0 - d                 -- the turn after the pointer, d further
    return
  end
  if askBrain("flightStandTurnProngs", { degrees = d }) then return end
  if hold == nil then
    if busy then return end
    hold = { offset = 0 }
    hold.items, hold.skip = detachVisual(matrix(self.getRotation()))
    Wait.frames(holdStep, 1)
  end
  hold.offset = hold.offset + d
end

local function dropHeld()
  local h = hold
  if h == nil then return end
  hold = nil
  turn(0, h.offset, h.items)
end

-- Dropped after a turn of its prongs (the loop has already put it back, see
-- pinGrab): in place, locked, once more a frame later, then the prongs go
-- on again.
local function dropProngs()
  local g = grab
  if g == nil then return end
  grab = nil
  self.setLock(true)
  pinGrab(g)
  Wait.frames(function()
    pinGrab(g)
    turn(0, g.delta, g.items)
  end, 1)
end

-- Chained after the mini script's own handlers (this script is appended).
local prevPickedUp, prevDropped = onPickedUp, onDropped
function onPickedUp(color)
  if prevPickedUp then prevPickedUp(color) end
  grabProngs(color)
end
function onDropped(color)
  dropProngs()
  dropHeld()
  if prevDropped then prevDropped(color) end
end

-- Right-click > Repair stand: the prongs squared again under the hub, as
-- after an A/E turn (prongs knocked askew by terrain).
self.addContextMenuItem("Repair stand", function() turn(0, 0, nil, true) end)

-- Called for EVERY player action on any object: leave as early as possible.
function onPlayerAction(player, action, targets)
  if action ~= ROTATE_LEFT and action ~= ROTATE_RIGHT then return true end
  local ours = false
  for _, o in ipairs(targets or {}) do
    if o == self then ours = true break end
  end
  if not ours then return true end
  local dir = action == ROTATE_LEFT and -1 or 1
  if self.held_by_color then
    turnHeldProngs(dir * HELD_STEP)
    return false
  end
  local ptr, p = player.getPointerPosition(), self.getPosition()
  if ptr and (ptr.x - p.x) ^ 2 + (ptr.z - p.z) ^ 2 > HUB_RADIUS ^ 2 then
    turn(0, dir * STEP)
  else
    turn(dir * STEP, 0)
  end
  return false
end

]==]
