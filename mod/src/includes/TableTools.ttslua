-- The table's small fixed tools, equipped by the brain.
--
-- Why: giving an object a script costs 30-45 ms when it appears, whatever
-- the script. These 28 tools only needed theirs to make themselves
-- unclickable, put a button or a menu entry on themselves and keep a small
-- state: about 1 to 1.4 s of every load (measured 14/11/2026). They now carry
-- no script; their memo
-- says what they are, and the brain gives them the very same buttons, owned
-- by the brain (a button owned by another script works, and the click comes
-- here with the object clicked, measured 14/11/2026):
--   {tool = "spawnDice", side = "red"|"blue", dice = "BlackAttack"|...}
--   {tool = "roll" | "clear", side = "red"|"blue"}
--   {tool = "returnTokens"} / {tool = "removeSuppression"}  (the asset buttons)
--   {tool = "rulesPage"}   (finds its lectern through its GMNotes)
--   {tool = "lectern"}     (a rules PDF: "Go to page" in its right-click menu)
--   {tool = "turnCounter"} (in each of its five states: < and > buttons)
--   {tool = "commandStack"} (sized and tinted by the tokens it holds)
--   {tool = "inert"}       (the table, the two label panels: unclickable only)
-- The two chess clocks need no memo: the brain keeps their time in its own
-- save (tableToolsSaveClocks / tableToolsRestoreClocks).
--
-- Buttons are not saved: the brain equips the tools at load, as each one
-- leaves the setup crate, and whenever one appears (a paste, a state change).
-- Equipping twice is harmless.

local GREY = {0.7573, 0.7573, 0.7573, 0.01}
local BLACK = {0, 0, 0, 100}
local WHITE = {1, 1, 1, 100}
local RED_TEXT = {0.7692, 0, 0, 100}

local DICE = {
  BlackAttack = {call = "spawnBlackAttackDice", tooltip = "Spawn Black Attack Dice", font = WHITE},
  RedAttack = {call = "spawnRedAttackDice", tooltip = "Spawn Red Attack Dice", font = WHITE},
  WhiteAttack = {call = "spawnWhiteAttackDice", tooltip = "Spawn White Attack Dice", font = RED_TEXT},
  RedDefense = {call = "spawnRedDefenseDice", tooltip = "Spawn Red Defense Dice", font = WHITE},
  WhiteDefense = {call = "spawnWhiteDefenseDice", tooltip = "Spawn White Defense Dice", font = RED_TEXT},
}

function tableToolWiring(obj)
  if obj == nil then
    return nil
  end
  local memo = obj.memo
  if memo == nil or memo == "" or not string.find(memo, '"tool"', 1, true) then
    return nil
  end
  local ok, w = pcall(JSON.decode, memo)
  if ok and type(w) == "table" and type(w.tool) == "string" then
    return w
  end
  return nil
end

-- The die roller of a tool's side, and the tool's wiring.
local function dieRoller(obj)
  local w = tableToolWiring(obj)
  if w == nil or w.side == nil then
    return nil, nil
  end
  return getObjectFromGUID(dieRollerInfo[w.side .. "DieRollerGUID"] or ""), w
end

local function press(obj)
  pcall(function() obj.AssetBundle.playTriggerEffect(0) end)
end

-- Click handlers: the button's owner is the brain, so TTS calls these with
-- the object clicked.

function tableToolSpawnDice(obj)
  local roller, w = dieRoller(obj)
  if roller == nil or DICE[w.dice] == nil then
    return
  end
  press(obj)
  roller.call(DICE[w.dice].call)
end

function tableToolRoll(obj, color)
  local roller = dieRoller(obj)
  if roller == nil then
    return
  end
  press(obj)
  roller.call("rollDie", {color})
end

function tableToolClear(obj)
  local roller = dieRoller(obj)
  if roller == nil then
    return
  end
  press(obj)
  roller.call("clearDie")
end

function tableToolRemoveSuppression(obj)
  press(obj)
  gRemoveOneSuppression({})
end

-- A token (or a stack of them) back above its bag, staggered so they land
-- one on another.
local function returnToken(bag, obj, number)
  local bagPos = bag.getPosition()
  local chips = obj.getQuantity()
  if chips > 0 then
    for _ = 1, chips do
      local taken = obj.takeObject({top = true})
      taken.setRotation({0, 0, 0})
      taken.setPositionSmooth({bagPos.x, bagPos.y + number, bagPos.z})
      number = number + 2
    end
  else
    obj.setRotation({0, 0, 0})
    obj.setPositionSmooth({bagPos.x, bagPos.y + number, bagPos.z})
    number = number + 2
  end
  return number
end

-- Aim, dodge, standby, surge, smoke and observation tokens back to their
-- bags, order tokens back to their tray.
function tableToolReturnTokens(obj)
  press(obj)
  local zone = getObjectFromGUID(battlefieldZoneGUID)
  if zone == nil then
    return
  end
  local bags = {
    ["Aim Token"] = aimBagGUID,
    ["Dodge Token"] = dodgeBagGUID,
    ["Standby Token"] = standbyBagGUID,
    ["Surge Token"] = surgeBagGUID,
    ["Smoke Token"] = smokeBagGUID,
    ["Observation Token"] = observationBagGUID,
  }
  local numbers = {}
  local commandNumber = 1
  for _, o in pairs(zone.getObjects() or {}) do
    local bagGUID = bags[o.getName()]
    if bagGUID ~= nil then
      local bag = getObjectFromGUID(bagGUID)
      if bag ~= nil then
        numbers[bagGUID] = returnToken(bag, o, numbers[bagGUID] or 1)
      end
    elseif o.getVar("isAToken") == true then
      local unitData = o.getTable("unitData")
      local tray = getObjectFromGUID(commandTokenTrayData[unitData.colorSide][unitData.commandType])
      local pos = tray.getPosition()
      pos.y = pos.y + 0.5 + (0.2 * commandNumber)
      o.setPositionSmooth(pos, false, false)
      o.setRotationSmooth(tray.getRotation(), false, false)
      commandNumber = commandNumber + 1
    end
  end
end

-- Asks the player for a page of a rules PDF. Book.setPage takes effect at
-- once, no reload involved.
function tableToolGoToPage(lectern, color)
  local book = lectern.Book
  if not book then
    return
  end
  Player[color].showInputDialog("Page number", tostring(book.getPage()), function(text)
    local page = tonumber(text)
    if not page then
      return
    end
    page = math.floor(page)
    if not book.setPage(page) then
      broadcastToColor("This document has no page " .. page .. ".", color, {1, 0.5, 0.5})
    end
  end)
end

-- A page box finds its lectern by the mark in its GMNotes, not by GUID:
-- swapping a document respawns the lectern, which can change its GUID.
function tableToolRulesPage(obj, color)
  press(obj)
  local index = string.match(obj.getGMNotes() or "", "^rules%-page%-(%d+)$")
  local wanted = index and ("rules-lectern-" .. index)
  for _, o in ipairs(getAllObjects()) do
    if wanted ~= nil and o.getGMNotes() == wanted then
      tableToolGoToPage(o, color)
      return
    end
  end
  broadcastToColor("The lectern for this button is missing.", color, {1, 0.5, 0.5})
end

-- The turn counter has five states; changing state respawns it under a new
-- GUID, which the brain hears as a spawn and equips again.
function tableToolTurnPrev(obj)
  obj.setState(obj.getStateId() - 1)
end

function tableToolTurnNext(obj)
  obj.setState(obj.getStateId() + 1)
end

-- A command stack stands as tall as the tokens it holds, and turns blue
-- when empty.
local function updateCommandStack(stack)
  local tokens = stack.getObjects()
  if #tokens == 0 then
    stack.setColorTint({65 / 255, 88 / 255, 114 / 255})
    stack.setScale({1, 1, 1})
  else
    stack.setScale({1, #tokens, 1})
    stack.setColorTint({1, 1, 1})
  end
end

-- Called by the command trays after stacking or shuffling (they live in
-- their own scripts, hence the GUID).
function tableToolUpdateCommandStack(params)
  local stack = getObjectFromGUID(params.guid or "")
  if stack ~= nil then
    updateCommandStack(stack)
  end
end

function tableToolOnLeaveContainer(container)
  local w = tableToolWiring(container)
  if w ~= nil and w.tool == "commandStack" then
    updateCommandStack(container)
  end
end

-- The chess clocks' time, kept in the brain's save.
function tableToolsSaveClocks()
  local values = {}
  for side, guid in pairs(clockGUIDs or {}) do
    local clock = getObjectFromGUID(guid)
    if clock ~= nil then
      values[side] = clock.Clock.getValue()
    end
  end
  return values
end

function tableToolsRestoreClocks(values)
  for side, value in pairs(values or {}) do
    local clock = getObjectFromGUID((clockGUIDs or {})[side] or "")
    if clock ~= nil and tonumber(value) then
      clock.Clock.setValue(tonumber(value))
    end
  end
end

-- The buttons, as the tools' own scripts made them.

-- A button owned by the brain: a shared look, then this button's own fields.
local function button(obj, fn, look, fields)
  local b = {click_function = fn, function_owner = self, position = {0, 0.65, 0}}
  for k, v in pairs(look or {}) do b[k] = v end
  for k, v in pairs(fields) do b[k] = v end
  obj.createButton(b)
end

-- The square grey plates (CLEAR, the token buttons, PAGE).
local PLATE = {scale = {1, 1, 0.7}, width = 1500, height = 2000, font_size = 400, color = GREY, font_color = BLACK}
local TURN = {scale = {0.5, 0.5, 0.5}, width = 400, height = 500, font_size = 400,
  color = {0.1498, 0.1498, 0.1498, 1}, font_color = {1, 1, 1, 1}}

local EQUIP = {
  spawnDice = function(obj, w)
    local dice = DICE[w.dice]
    if dice == nil then
      return
    end
    obj.interactable = false
    button(obj, "tableToolSpawnDice", nil, {label = "", width = 1400, height = 1400, font_size = 1100,
      color = {1, 1, 1, 0.01}, font_color = dice.font, tooltip = dice.tooltip, alignment = 3})
  end,
  roll = function(obj)
    obj.interactable = false
    button(obj, "tableToolRoll", nil, {label = "ROLL", width = 1400, height = 1400, font_size = 500,
      color = GREY, font_color = BLACK, tooltip = "Roll Die"})
  end,
  clear = function(obj)
    obj.interactable = false
    button(obj, "tableToolClear", PLATE, {label = "CLEAR", tooltip = "Clear Die"})
  end,
  returnTokens = function(obj)
    button(obj, "tableToolReturnTokens", PLATE, {label = "",
      tooltip = "Return all Aim, Dodge, Standby and Command Tokens to the respective Players"})
    obj.setColorTint({0.7, 0, 0})
  end,
  removeSuppression = function(obj)
    button(obj, "tableToolRemoveSuppression", PLATE, {label = "",
      tooltip = "Remove one suppression from each suppression token in the Battlefield"})
  end,
  rulesPage = function(obj)
    button(obj, "tableToolRulesPage", PLATE, {label = "PAGE", scale = {1, 1, 1.4},
      tooltip = "Jump to a page of the document above"})
    obj.setColorTint({0.93, 0.94, 0.88})
  end,
  lectern = function(obj)
    obj.clearContextMenu()
    obj.addContextMenuItem("Go to page", function(color)
      tableToolGoToPage(obj, color)
    end)
  end,
  turnCounter = function(obj)
    local state = obj.getStateId()
    if state > 1 then
      button(obj, "tableToolTurnPrev", TURN, {label = "<", position = {-0.95, 0.1, 0}})
    end
    if state < 5 then
      button(obj, "tableToolTurnNext", TURN, {label = ">", position = {0.95, 0.1, 0}})
    end
  end,
  commandStack = function(obj)
    -- A custom bag is only a container once its model has loaded.
    Wait.condition(function()
      pcall(updateCommandStack, obj)
    end, function()
      local ok, loading = pcall(function() return obj.loading_custom end)
      return not ok or not loading
    end)
  end,
  inert = function(obj)
    obj.interactable = false
  end,
}

-- Equips one object if its memo names a tool; harmless on anything else.
function tableToolEquip(obj)
  local w = tableToolWiring(obj)
  local equip = w and EQUIP[w.tool]
  if equip == nil then
    return
  end
  obj.clearButtons()
  equip(obj, w)
end

function tableToolsInit()
  for _, obj in ipairs(getAllObjects()) do
    pcall(tableToolEquip, obj)
  end
end
