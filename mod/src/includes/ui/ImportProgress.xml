<!-- The import toast: a rounded dark pill (sprite, soft drop shadow) with
     a small bold label and a thin rounded progress bar tinted the importing
     player's color. The pill sprite carries 24 px of shadow margin on every
     side, hence the anchored children instead of a layout.

     One panel per player, because both can import at the same time: a single
     shared toast let whichever list started last relabel the other's, and
     whichever finished first hide it. Each player owns a slot, so two imports
     stack instead of fighting, and the bar colour is baked in rather than set
     from the script. -->
<Panel
  id="importProgressRed"
  active="false"
  rectAlignment="UpperCenter"
  offsetXY="0 -28"
  width="388"
  height="104"
  image="isqUiPill"
>
  <Text
    id="importProgressTextRed"
    rectAlignment="UpperCenter"
    offsetXY="0 -38"
    width="300"
    height="20"
    fontSize="15"
    color="#EDEDF2"
    fontStyle="Bold"
    alignment="MiddleCenter"
  >IMPORTING LIST</Text>
  <ProgressBar
    id="importProgressBarRed"
    rectAlignment="UpperCenter"
    offsetXY="0 -64"
    width="300"
    height="10"
    percentage="0"
    showPercentageText="false"
    image="isqUiTrack"
    fillImage="isqUiFill"
    fillImageColor="#FF5A5A"
  />
</Panel>
<Panel
  id="importProgressBlue"
  active="false"
  rectAlignment="UpperCenter"
  offsetXY="0 -108"
  width="388"
  height="104"
  image="isqUiPill"
>
  <Text
    id="importProgressTextBlue"
    rectAlignment="UpperCenter"
    offsetXY="0 -38"
    width="300"
    height="20"
    fontSize="15"
    color="#EDEDF2"
    fontStyle="Bold"
    alignment="MiddleCenter"
  >IMPORTING LIST</Text>
  <ProgressBar
    id="importProgressBarBlue"
    rectAlignment="UpperCenter"
    offsetXY="0 -64"
    width="300"
    height="10"
    percentage="0"
    showPercentageText="false"
    image="isqUiTrack"
    fillImage="isqUiFill"
    fillImageColor="#58A6FF"
  />
</Panel>
