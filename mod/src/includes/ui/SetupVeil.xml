<!-- Two panels rather than a ProgressBar: a ProgressBar would not span
     the screen, and its fill is driven by a percentage attribute we cannot
     stretch. Here the track is the full width and the fill is a percentage
     OF THE TRACK, so the rule reaches both edges whatever the resolution.
     The rule is nudged 20 above its anchor: TTS starts the UI frame a
     little below the window's top edge, and nothing clips what overflows
     it — the backdrop already spills past that line — so this is what puts
     the rule on the edge itself rather than a score of pixels under it. -->
<Panel
  id="setupVeilBar"
  active="true"
  rectAlignment="UpperCenter"
  offsetXY="0 20"
  width="100%"
  height="6"
  color="#00000000"
>
  <Panel
    id="setupVeilBarFill"
    rectAlignment="MiddleLeft"
    width="0%"
    height="100%"
    color="#E8801AFF"
  />
</Panel>
